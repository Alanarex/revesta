APP_NAME=Revesta
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://admin.revesta.fr

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAYS=14

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=revesta
DB_USERNAME=revesta
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_DOMAIN=admin.revesta.fr
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=tls
MAIL_FROM_ADDRESS=no-reply@revesta.fr
MAIL_FROM_NAME="${APP_NAME}"
CONTACT_EMAIL=contact@revesta.fr

PASSPORT_PASSWORD_CLIENT_ID=
PASSPORT_PASSWORD_CLIENT_SECRET=
