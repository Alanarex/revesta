APP_NAME=Revesta
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
DEBUGBAR_ENABLED=true

PHPMYADMIN_URL=https://pma.revesta.fr
PHPMYADMIN_ALLOWED_IPS=

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_DAYS=8
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=revesta_db
DB_USERNAME=root
DB_PASSWORD=root

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Local default: write emails to logs instead of sending them.
# Production OVH example:
# MAIL_MAILER=smtp
# MAIL_SCHEME=null
# MAIL_HOST=ssl0.ovh.net
# MAIL_PORT=587
# MAIL_USERNAME=contact@revesta.fr
# MAIL_PASSWORD=change-me
# MAIL_FROM_ADDRESS=contact@revesta.fr
# MAIL_FROM_NAME="${APP_NAME}"
#
# Important:
# - MAIL_FROM_ADDRESS must be a real email address, not a domain.
# - After changing mail or queue values in production, run:
#   php artisan config:clear && php artisan cache:clear && php artisan queue:restart
# - QUEUE_CONNECTION=database requires a running queue worker for queued mail.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME="${APP_NAME}"

# Password Reset Configuration
PASSWORD_RESET_EXPIRE=15
PASSWORD_RESET_THROTTLE=60

# Contact Email (used in password reset emails)
CONTACT_EMAIL="contact@revesta.fr"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

PASSPORT_PASSWORD_CLIENT_ID=
PASSPORT_PASSWORD_CLIENT_SECRET=
