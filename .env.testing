# Testing Environment Configuration
# This file is used when running tests via `php artisan test` or `phpunit`
# It isolates the test environment from your local development database

# Use a separate MySQL test database to avoid affecting the local database
# Make sure the revesta_testing database exists before running tests
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=revesta_testing
DB_USERNAME=root
DB_PASSWORD=root

# Copy other settings from .env that are needed for tests
APP_NAME=Revesta
APP_ENV=testing
APP_DEBUG=true
APP_KEY=base64:fV/JqZIGtG5O7VBLMb48E4kYd/7Yqwm6YmRUq6th8Pc=

# Cache and queue settings for tests
CACHE_STORE=array
QUEUE_CONNECTION=sync

# Disable telescope and pulse for faster tests
TELESCOPE_ENABLED=false
PULSE_ENABLED=false

# Use array driver for session during tests
SESSION_DRIVER=array

# Use array driver for mail (no emails sent during tests)
MAIL_MAILER=array

PASSPORT_PASSWORD_CLIENT_ID=019bffe0-db49-71e0-9623-2e047ce72ee9
PASSPORT_PASSWORD_CLIENT_SECRET=MwkBZgNWU722tbv1oo4jhQUT79zM8mgRGtCzJqZQ
